  "devDependencies":{
    "@types/react":"^18.3.12",
    "@types/react-dom":"^18.3.1",
    "@vitejs/plugin-react":"^4.3.4",
    "@vitest/coverage-v8":"^3.2.4",
    "typescript":"^5.7.2",
    "vite":"^6.3.0",
    "vitest":"^3.2.4"
  }
}